# Copy to .env and adjust. Never commit a real .env.
APP_NAME=D3COY
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/d3coy.db
SEED_ON_STARTUP=true

# REQUIRED for admin endpoints (suspend/reactivate, reviews, scenarios, credential issuing).
# Admin endpoints return 503 until this is set. Prototype only: not production identity management.
ADMIN_API_KEY=change-this-local-demo-key

# Agent authentication. When true, POST /api/events requires a per-agent bearer token
# (Authorization: Bearer d3a_...) issued via POST /api/agents/{id}/credentials, or an admin key
# for trusted internal callers (simulator/demos). Set false ONLY for local experiments.
AGENT_AUTH_REQUIRED=true

# Shared HMAC key between D3COY and the sandbox tool executor for signing permission slips.
# MUST be identical in both processes. Sandbox tools cannot run unless this is set in both.
PERMISSION_SIGNING_KEY=set-a-shared-secret-used-by-both-services
PERMISSION_TTL_SECONDS=60
REVIEW_TTL_MINUTES=60

# The separate sandbox tool-executor service (runs the real dummy-data tools).
EXECUTOR_URL=http://127.0.0.1:8100
EXECUTOR_TIMEOUT_SECONDS=10

# --- LLM for the real Procurement Agent (optional; only agent/ uses it, not the security core) ---
# Gemini has a free tier (Google AI Studio: https://aistudio.google.com/apikey). Set ONE of these.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Force a provider / model (otherwise auto: Gemini if a Google key is set, else Claude):
# D3COY_AGENT_PROVIDER=gemini
# D3COY_AGENT_MODEL=gemini-3.8-flash

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Behavioral detection
ARTIFACTS_DIR=./artifacts
AUTO_TRAIN_BASELINE=true
BEHAVIOR_WINDOW_SIZE=10
BEHAVIOR_MIN_HISTORY=3
BEHAVIOR_MONITOR_SCORE=50
BEHAVIOR_REVIEW_SCORE=65
RIVER_ENABLED=true
RIVER_WEIGHT=0.25
RIVER_MIN_TRUSTED_BATCH=25

# Semantic intent validation
SEMANTIC_ENABLED=true
SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_ALLOW_DOWNLOAD=true
SEMANTIC_FALLBACK=none
SEMANTIC_ALIGNED_SIMILARITY=0.45
SEMANTIC_MISALIGNED_SIMILARITY=0.10

# Risk scoring: R = 0.40P + 0.25B + 0.20S + 0.15C (weights must sum to 1)
RISK_WEIGHT_POLICY=0.40
RISK_WEIGHT_BEHAVIOR=0.25
RISK_WEIGHT_SEMANTIC=0.20
RISK_WEIGHT_CONTEXT=0.15
RISK_MONITOR_THRESHOLD=25
RISK_REVIEW_THRESHOLD=50
RISK_BLOCK_THRESHOLD=75
FAIL_CLOSED_ON_UNAVAILABLE_DETECTORS=true

# Escalation: suspend an agent after N high-severity blocks within the window
ESCALATION_ENABLED=true
ESCALATION_BLOCK_COUNT=3
ESCALATION_WINDOW_MINUTES=30

INTERNAL_EMAIL_DOMAINS=d3coy.local
MAX_CLOCK_SKEW_SECONDS=300
MAX_EVENT_AGE_HOURS=24

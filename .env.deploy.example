# Copy to .env (next to docker-compose.yml) and fill in. docker compose reads this file.

# REQUIRED. Shared HMAC key between the gateway and the executor. Must be identical for both
# (compose passes this one value to both services). Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
PERMISSION_SIGNING_KEY=

# OPTIONAL. Admin key for the dashboard (suspend/reactivate, reviews, scenarios, live-agent run).
# LEAVE BLANK for open mode: no login needed, anyone who opens the dashboard can run everything.
# Set it to a strong value to require that key (entered in the dashboard's Admin login).
ADMIN_API_KEY=

# Where the browser reaches the gateway, and which origins the gateway allows (the frontend origin).
# Defaults assume everything runs on this machine with the published ports below.
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# OPTIONAL. LLM for the live-agent demo (leave blank to disable the "Run agent" button).
GEMINI_API_KEY=
D3COY_AGENT_PROVIDER=gemini
D3COY_AGENT_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC SERVER DEPLOYMENT (docker-compose.prod.yml) — see DEPLOY-SERVER.md
# Only needed when serving a public HTTPS URL behind Caddy. Ignored by the local
# docker-compose.yml. The UI and API share this ONE origin (no CORS, wss:// works).
# ─────────────────────────────────────────────────────────────────────────────
# Your DuckDNS hostname (no scheme) and the full URL. Both point at the SAME name.
PUBLIC_HOST=
PUBLIC_URL=
# For a public URL, SET A STRONG ADMIN_API_KEY above (replaces open mode) unless you
# deliberately want anyone on the internet to be able to run agents and reviews.

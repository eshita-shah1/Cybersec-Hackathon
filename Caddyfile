{$PUBLIC_HOST} {
	encode zstd gzip

	# API + live WebSocket + API docs go to the gateway. Everything else is the SPA.
	# (Caddy upgrades /ws/* to a WebSocket automatically.)
	@backend path /api/* /ws/* /docs /openapi.json /redoc /health
	handle @backend {
		reverse_proxy gateway:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}
